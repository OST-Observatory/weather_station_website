SECRET_KEY=____secret_key_used_in_production+++keep_secret+++
DJANGO_ENV=development
DATABASE_NAME=ost_weather_db
DATABASE_USER=ost_weather_user
DATABASE_PASSWORD=long_database_password
DATABASE_HOST=localhost
DATABASE_PORT=
ALLOWED_HOSTS=server_url,server_ip,localhost
LOG_DIR=logs/
DEFAULT_FROM_EMAIL=aots@example.de
TRUSTED_ORIGIN=https://trusted_origin.net
# Leave False when Apache handles HTTPS (typical). True only if Apache sets X-Forwarded-Proto.
SECURE_SSL_REDIRECT=False
# Plot / dashboard local time (IANA). Storage stays UTC.
PLOT_DISPLAY_TIMEZONE=Europe/Berlin
# Upload auth: dual during migration, then hmac_only
UPLOAD_AUTH_MODE=dual
UPLOAD_LEGACY_BASIC_USERNAME=data_upload_user
UPLOAD_HMAC_CANONICAL_PATH=/weather_station/weather_api/datasets/
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UPLOAD_CREDENTIAL_MASTER_KEY=
# Production only — required when DJANGO_ENV=production
# REDIS_URL=redis://127.0.0.1:6379/0
# SECURE_HSTS_SECONDS=3600
